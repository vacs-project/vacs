{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "core:window:allow-close",
    "core:webview:allow-set-webview-zoom",
    "deep-link:default",
    "log:default",
    "updater:default"
  ]
}
