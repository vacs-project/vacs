{{!--
Copy of tauri-bundler's default template with %u added to Exec. Without a field code the
entry is launched without the vacs:// url it was asked to open, which silently breaks login
when the link is resolved through the packaged entry (xdg-desktop-portal, app choosers).
Drop this override once https://github.com/tauri-apps/tauri/issues/15928 is fixed upstream.
--}}
[Desktop Entry]
Categories={{categories}}
{{#if comment}}
Comment={{comment}}
{{/if}}
Exec={{exec}} %u
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
